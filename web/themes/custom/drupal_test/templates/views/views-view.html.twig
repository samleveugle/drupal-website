{#
/**
 * @file
 * Views wrapper.
 *
 * Drupal 11 core does not wrap rows in .view-content. We add that wrapper
 * so a CSS grid has one container. Card listings also get .listing-grid.
 */
#}
{%
  set classes = [
    'view',
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {{ title }}
  {{ title_suffix }}

  {% if header %}
    <header>
      {{ header }}
    </header>
  {% endif %}

  {% if exposed %}
    <div class="view-filters">
      {{ exposed }}
    </div>
  {% endif %}

  {{ attachment_before }}

  {% if rows -%}
    <div class="view-content{% if is_card_grid %} listing-grid{% endif %}">
      {{ rows }}
    </div>
  {% elseif empty -%}
    {{ empty }}
  {% endif %}

  {{ pager }}
  {{ attachment_after }}
  {{ more }}

  {% if footer %}
    <footer>
      {{ footer }}
    </footer>
  {% endif %}

  {{ feed_icons }}
</div>
