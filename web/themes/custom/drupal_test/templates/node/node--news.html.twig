{#
/**
 * @file
 * News detail: back link, title, image left / body right.
 */
#}
<article{{ attributes.addClass('node', 'node--news', 'node--detail') }}>
  {{ title_prefix }}
  {{ title_suffix }}

  {% if overview_url %}
    <a class="node__back" href="{{ overview_url }}">{{ 'back to overview'|t }}</a>
  {% endif %}

  <h1 class="node__title">{{ label }}</h1>

  {% set news_image = content.field_image|render %}
  <div class="node__split">
    {% if news_image|trim %}
      <div class="node__media">
        {{ news_image }}
      </div>
    {% endif %}
    <div class="node__copy">
      {{ content.field_body }}
    </div>
  </div>
</article>
