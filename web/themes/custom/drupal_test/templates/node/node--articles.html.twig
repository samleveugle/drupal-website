{#
/**
 * @file
 * Article detail: same split as news, plus tags and country.
 */
#}
<article{{ attributes.addClass('node', 'node--articles', 'node--detail') }}>
  {{ title_prefix }}
  {{ title_suffix }}

  {% if overview_url %}
    <a class="node__back" href="{{ overview_url }}">{{ 'back to overview'|t }}</a>
  {% endif %}

  <h1 class="node__title">{{ label }}</h1>

  {# Render the image once. |render in an if plus {{ content.field_image }}
     can print the photo and leave an empty wrapper (extra grey box). #}
  {% set article_image = content.field_image|render %}
  <div class="node__split">
    {% if article_image|trim %}
      <div class="node__media">
        {{ article_image }}
      </div>
    {% endif %}
    <div class="node__copy">
      {{ content.field_body }}
      {{ content.field_tags }}
      {% if article_country %}
        <p class="node__country">{{ 'Country: @country'|t({'@country': article_country}) }}</p>
      {% endif %}
    </div>
  </div>
</article>
