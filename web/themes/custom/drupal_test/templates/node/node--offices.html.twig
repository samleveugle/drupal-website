{#
/**
 * @file
 * Office detail: photo left, contact fields right (from the node, not hardcoded).
 */
#}
<article{{ attributes.addClass('node', 'node--offices', 'node--detail') }}>
  {{ title_prefix }}
  {{ title_suffix }}

  {% if overview_url %}
    <a class="node__back" href="{{ overview_url }}">{{ 'back to overview'|t }}</a>
  {% endif %}

  <h1 class="node__title">{{ label }}</h1>

  <div class="node__split">
    {% set office_image = content.field_image|render %}
    <div class="node__media">
      {% if office_image|trim %}
        {{ office_image }}
      {% endif %}
    </div>
    <div class="node__copy office-contact">
      {% if node.field_tel.value %}
        <p><span class="office-contact__label">{{ 'Tel'|t }}</span> {{ node.field_tel.value }}</p>
      {% endif %}
      {% if node.field_fax.value %}
        <p><span class="office-contact__label">{{ 'Fax'|t }}</span> {{ node.field_fax.value }}</p>
      {% endif %}
      {% if node.field_adress.value %}
        <p><span class="office-contact__label">{{ 'Address'|t }}</span> {{ node.field_adress.value }}</p>
      {% endif %}
      {% if node.field_email.value %}
        <p><span class="office-contact__label">{{ 'Email'|t }}</span> <a href="mailto:{{ node.field_email.value }}">{{ node.field_email.value }}</a></p>
      {% endif %}
      {% if node.field_contact_person.value %}
        <p><span class="office-contact__label">{{ 'Contact person'|t }}</span> {{ node.field_contact_person.value }}</p>
      {% endif %}
    </div>
  </div>
</article>
